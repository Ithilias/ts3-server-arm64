# Copy to `.env` and adjust. All values are optional; defaults shown.

# Ports (must match the published ports in docker-compose.yml)
#TS3_VOICE_PORT=9987
#TS3_FILETRANSFER_PORT=30033
#TS3_QUERY_SSH_PORT=10022

# ServerQuery protocols. Keep `ssh` only — never enable the plaintext `raw`
# protocol on a public-internet link.
#TS3_QUERY_PROTOCOLS=ssh

# Healthcheck TCP port. Defaults to TS3_QUERY_SSH_PORT; override if you run a
# different query protocol/port or a custom ini (e.g. raw on 10011).
#TS3_HEALTHCHECK_PORT=10022

# Seed the `serveradmin` ServerQuery password. Applied ONLY on first boot (when
# the database doesn't exist yet); ignored afterwards, so it won't revert a
# password you later change in-app. Otherwise a token is printed in the logs on
# first start. Briefly visible in the process list during that first boot.
#TS3_QUERY_ADMIN_PASSWORD=change-me

# Mount your own ini and point this at it to bypass env-driven generation.
#TS3SERVER_INI=/data/ts3server.ini

# Run as a specific host uid/gid (defaults to 1000:1000).
#PUID=1000
#PGID=1000

# Timezone for log timestamps.
#TZ=Europe/Berlin
